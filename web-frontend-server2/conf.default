server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /metrics {
        default_type text/plain;
        return 200 "# HELP web_frontend_up Trang thai hoat dong cua Web Server 2\n# TYPE web_frontend_up gauge\nweb_frontend_up 1\n";
    }
}
